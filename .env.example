# Copie este arquivo para .env.local. A chave é a publicável: pode ir ao navegador, quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_URL=https://evasqrulqdevigdnfzfi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TS3lBYTaOnIuCpcHzZZltA_rTQPW2Lm

# Em produção, defina a URL pública (usada no link de confirmação do e-mail)
# NEXT_PUBLIC_SITE_URL=https://mygrana.vercel.app

# Cotações da B3 (ações, FIIs, ETFs, BDRs). Token grátis em https://brapi.dev — fica só no servidor.
# BRAPI_TOKEN=seu_token_aqui

# Open Finance (Pluggy). Crie a aplicação em https://dashboard.pluggy.ai — só no servidor, nunca NEXT_PUBLIC.
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=

# ---- Só no servidor (Vercel → Settings → Environment Variables). Nunca coloque NEXT_PUBLIC_ nestas. ----

# Excluir conta e resumo diário por push. Supabase → Project Settings → API Keys → secret key.
# SUPABASE_SERVICE_ROLE_KEY=

# Assistente com IA (opcional). Chave em https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Notificações push (opcional). Gere com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   (esta pode ir ao navegador)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Protege a rota do cron diário (/api/cron/avisos). Qualquer texto aleatório com 32+ caracteres.
# CRON_SECRET=
